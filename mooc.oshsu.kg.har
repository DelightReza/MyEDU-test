          "content": {
            "size": 1785,
            "mimeType": "application/json",
            "text": "{\"success\":true,\"step\":{\"id\":83209,\"id_parent\":38361,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22390,\"step\":3,\"active\":false,\"created_at\":\"2026-03-10T10:04:39.000000Z\",\"updated_at\":\"2026-03-10T10:05:59.000000Z\",\"score\":1,\"content\":{\"id\":38361,\"lesson_id\":22390,\"content\":\"In a clinical trial investigating a new antibiotic for pneumonia, complications occurred in 20% of patients receiving standard therapy and in 10% of patients receiving the new drug. Which of the following interpretations is the most accurate?\\n\",\"score\":1,\"image\":null,\"answers\":[{\"id\":145702,\"text\":\"The NNT is 10, meaning ten patients must be treated with the new drug instead of the standard therapy to prevent one additional complication.\"},{\"id\":145703,\"text\":\"The NNT is 10, meaning the drug will prevent complications in 10% of all treated patients.\"},{\"id\":145704,\"text\":\"The NNT is 0.10, indicating the probability that a patient benefits from treatment.\"},{\"id\":145705,\"text\":\"The NNT indicates the relative risk reduction of the treatment.\"}],\"created_at\":\"2026-03-10T10:05:59.000000Z\",\"updated_at\":\"2026-03-10T10:05:59.000000Z\"},\"connections\":{\"id\":2086,\"id_stream\":228909,\"id_curricula\":37853,\"id_subject\":10339,\"id_speciality\":21,\"id_faculty\":0,\"id_edu_year\":25,\"id_period\":1,\"course_id\":259421,\"subject_type\":null,\"id_subject_type\":1,\"user_id\":2891,\"active\":true,\"created_at\":\"2025-11-10T07:44:18.000000Z\",\"updated_at\":\"2026-02-25T06:12:59.000000Z\",\"proverka\":true,\"id_semester\":10,\"id_language\":1},\"chills\":null,\"count_attempt\":null,\"my_score\":null,\"details\":[],\"answer_id\":null,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}}}"
