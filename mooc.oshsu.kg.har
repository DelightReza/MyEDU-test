            "size": 1827,
            "mimeType": "application/json",
            "text": "{\"success\":true,\"step\":{\"id\":83204,\"id_parent\":38359,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22390,\"step\":2,\"active\":false,\"created_at\":\"2026-03-10T10:02:44.000000Z\",\"updated_at\":\"2026-03-10T10:04:31.000000Z\",\"score\":1,\"content\":{\"id\":38359,\"lesson_id\":22390,\"content\":\"In a clinical trial investigating a new statin, the results showed a relative risk of myocardial infarction of 0.82 with a 95% confidence interval of 0.68\\u20130.99. Which of the following interpretations is the most accurate?\\n \",\"score\":1,\"image\":null,\"answers\":[{\"id\":145694,\"text\":\"The drug definitely reduces the risk of myocardial infarction by exactly 18%.\"},{\"id\":145695,\"text\":\"The true effect of the drug is most likely somewhere between a 32% reduction and a 1% reduction in risk, and the result is clinically significant.\"},{\"id\":145696,\"text\":\"The probability that the drug reduces the risk is exactly 95%.\"},{\"id\":145697,\"text\":\"The true effect of the drug is most likely somewhere between a 32% reduction and a 1% reduction in risk, and the result is statistically significant.\"}],\"created_at\":\"2026-03-10T10:04:31.000000Z\",\"updated_at\":\"2026-03-10T10:04:31.000000Z\"},\"connections\":{\"id\":2086,\"id_stream\":228909,\"id_curricula\":37853,\"id_subject\":10339,\"id_speciality\":21,\"id_faculty\":0,\"id_edu_year\":25,\"id_period\":1,\"course_id\":259421,\"subject_type\":null,\"id_subject_type\":1,\"user_id\":2891,\"active\":true,\"created_at\":\"2025-11-10T07:44:18.000000Z\",\"updated_at\":\"2026-02-25T06:12:59.000000Z\",\"proverka\":true,\"id_semester\":10,\"id_language\":1},\"chills\":null,\"count_attempt\":null,\"my_score\":null,\"details\":[],\"answer_id\":null,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}}}"
