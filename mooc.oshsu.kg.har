            "text": "[{\"id\":82968,\"id_parent\":3135,\"type_id\":1,\"user_id\":2891,\"lesson_id\":22349,\"step\":2,\"active\":false,\"created_at\":\"2026-03-10T06:45:16.000000Z\",\"updated_at\":\"2026-03-10T06:45:43.000000Z\",\"score\":0,\"content\":{\"id\":3135,\"lesson_id\":22349,\"video_type_id\":1,\"title\":\"Data Collection: Method types and tools\",\"description\":\"\",\"link\":\"https:\\/\\/www.youtube.com\\/watch?v=_zyN3Wa_a7c\",\"cover\":null,\"cover_url\":null,\"created_at\":\"2026-03-10T06:45:43.000000Z\"},\"chills\":false,\"count_attempt\":null,\"my_score\":0,\"type\":{\"id\":1,\"title\":\"\\u0412\\u0438\\u0434\\u0435\\u043e\",\"modelName\":\"Vido\",\"logo\":\"pi pi-video\",\"name\":\"video\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":2}},{\"id\":82963,\"id_parent\":15909,\"type_id\":2,\"user_id\":2891,\"lesson_id\":22349,\"step\":1,\"active\":false,\"created_at\":\"2026-03-10T06:39:52.000000Z\",\"updated_at\":\"2026-03-10T06:40:56.000000Z\",\"score\":0,\"content\":{\"id\":15909,\"lesson_id\":22349,\"title\":\"Methods of Data Collection Digital Integration\",\"description\":\"\",\"document\":\"2891_22349_1773124856.pdf\",\"document_path\":\"https:\\/\\/api.mooc.oshsu.kg\\/public\\/teacher\\/files\\/lesson\\/documents\\/2891_22349_1773124856.pdf\",\"created_at\":\"2026-03-10T06:40:56.000000Z\"},\"chills\":false,\"count_attempt\":null,\"my_score\":0,\"type\":{\"id\":2,\"title\":\"\\u0414\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\",\"modelName\":\"Document\",\"logo\":\"pi pi-folder\",\"name\":\"document\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":1}},{\"id\":82970,\"id_parent\":3136,\"type_id\":1,\"user_id\":2891,\"lesson_id\":22349,\"step\":3,\"active\":false,\"created_at\":\"2026-03-10T06:46:07.000000Z\",\"updated_at\":\"2026-03-10T06:46:42.000000Z\",\"score\":0,\"content\":{\"id\":3136,\"lesson_id\":22349,\"video_type_id\":1,\"title\":\"Statistical tests for data analysis in research\",\"description\":\"\",\"link\":\"https:\\/\\/www.youtube.com\\/watch?v=LBQqGKY2dJ0\",\"cover\":null,\"cover_url\":null,\"created_at\":\"2026-03-10T06:46:42.000000Z\"},\"chills\":false,\"count_attempt\":0,\"my_score\":0,\"type\":{\"id\":1,\"title\":\"\\u0412\\u0438\\u0434\\u0435\\u043e\",\"modelName\":\"Vido\",\"logo\":\"pi pi-video\",\"name\":\"video\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":2}},{\"id\":82972,\"id_parent\":38196,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22349,\"step\":4,\"active\":false,\"created_at\":\"2026-03-10T06:46:57.000000Z\",\"updated_at\":\"2026-03-10T06:48:39.000000Z\",\"score\":1,\"content\":{\"id\":38196,\"lesson_id\":22349,\"content\":\"Which statement best explains why data collection quality is considered a critical component of clinical research?\\n \",\"score\":1,\"image\":null,\"answers\":[{\"id\":145042,\"text\":\"Statistical methods are unable to compensate for systematic errors introduced during data collection.\"},{\"id\":145043,\"text\":\"Regulatory agencies only approve studies conducted with digital data collection systems.\"},{\"id\":145044,\"text\":\"Clinical research conclusions depend primarily on the number of participants rather than data quality.\"},{\"id\":145045,\"text\":\"Data errors mainly affect administrative aspects of a study rather than scientific conclusions.\"}],\"created_at\":\"2026-03-10T06:48:39.000000Z\",\"updated_at\":\"2026-03-10T06:48:39.000000Z\"},\"chills\":false,\"count_attempt\":0,\"my_score\":0,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}},{\"id\":82974,\"id_parent\":38198,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22349,\"step\":5,\"active\":false,\"created_at\":\"2026-03-10T06:48:47.000000Z\",\"updated_at\":\"2026-03-10T06:49:44.000000Z\",\"score\":0,\"content\":{\"id\":38198,\"lesson_id\":22349,\"content\":\"Which of the following best describes the difference between routine clinical documentation and research-grade data?\\n \",\"score\":0,\"image\":null,\"answers\":[{\"id\":145050,\"text\":\"Clinical documentation focuses on narrative descriptions, whereas research data must allow standardized comparison and analysis across participants.\"},{\"id\":145051,\"text\":\"Research data are typically less detailed than clinical documentation because they focus only on primary outcomes.\"},{\"id\":145052,\"text\":\"Clinical documentation is mainly designed for statistical analysis, while research data focus on patient care.\"},{\"id\":145053,\"text\":\"Research data usually exclude subjective patient-reported information.\"}],\"created_at\":\"2026-03-10T06:49:44.000000Z\",\"updated_at\":\"2026-03-10T06:49:44.000000Z\"},\"chills\":false,\"count_attempt\":0,\"my_score\":0,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}},{\"id\":82979,\"id_parent\":38201,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22349,\"step\":6,\"active\":false,\"created_at\":\"2026-03-10T06:50:12.000000Z\",\"updated_at\":\"2026-03-10T06:51:11.000000Z\",\"score\":1,\"content\":{\"id\":38201,\"lesson_id\":22349,\"content\":\"Which of the following best describes the difference between routine clinical documentation and research-grade data?\\n\",\"score\":1,\"image\":null,\"answers\":[{\"id\":145062,\"text\":\"Clinical documentation focuses on narrative descriptions, whereas research data must allow standardized comparison and analysis across participants.\"},{\"id\":145063,\"text\":\"Research data are typically less detailed than clinical documentation because they focus only on primary outcomes.\"},{\"id\":145064,\"text\":\"Clinical documentation is mainly designed for statistical analysis, while research data focus on patient care.\"},{\"id\":145065,\"text\":\"Research data usually exclude subjective patient-reported information.\"}],\"created_at\":\"2026-03-10T06:51:11.000000Z\",\"updated_at\":\"2026-03-10T06:51:11.000000Z\"},\"chills\":false,\"count_attempt\":0,\"my_score\":0,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}},{\"id\":82981,\"id_parent\":38204,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22349,\"step\":7,\"active\":false,\"created_at\":\"2026-03-10T06:51:21.000000Z\",\"updated_at\":\"2026-03-10T06:52:12.000000Z\",\"score\":1,\"content\":{\"id\":38204,\"lesson_id\":22349,\"content\":\"Which of the following sources is most commonly used for generating Real-World Data?\\n \",\"score\":1,\"image\":null,\"answers\":[{\"id\":145074,\"text\":\"Controlled laboratory experiments\"},{\"id\":145075,\"text\":\"Electronic health records and patient registries\"},{\"id\":145076,\"text\":\"Simulation models of disease progression\"},{\"id\":145077,\"text\":\"Preclinical animal studies\"}],\"created_at\":\"2026-03-10T06:52:12.000000Z\",\"updated_at\":\"2026-03-10T06:52:12.000000Z\"},\"chills\":false,\"count_attempt\":0,\"my_score\":0,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}}]"
