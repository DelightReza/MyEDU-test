            "size": 1710,
            "mimeType": "application/json",
            "text": "{\"success\":true,\"step\":{\"id\":83214,\"id_parent\":38363,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22390,\"step\":4,\"active\":false,\"created_at\":\"2026-03-10T10:06:05.000000Z\",\"updated_at\":\"2026-03-10T10:07:21.000000Z\",\"score\":1,\"content\":{\"id\":38363,\"lesson_id\":22390,\"content\":\"A study finds that a new treatment reduces symptom severity with a p-value of 0.04. Which of the following statements correctly describes this p-value?\\n\",\"score\":1,\"image\":null,\"answers\":[{\"id\":145710,\"text\":\"The probability that the null hypothesis is true, given the observed data, is exactly 4%.\"},{\"id\":145711,\"text\":\"If there is truly no difference between treatments, the probability of seeing this result or more extreme is 4%.\"},{\"id\":145712,\"text\":\"The probability that the observed results are due to random sampling error is less than 4%.\"},{\"id\":145713,\"text\":\"There is a 96% chance that repeating the study would yield the same statistically significant result.\"}],\"created_at\":\"2026-03-10T10:07:21.000000Z\",\"updated_at\":\"2026-03-10T10:07:21.000000Z\"},\"connections\":{\"id\":2086,\"id_stream\":228909,\"id_curricula\":37853,\"id_subject\":10339,\"id_speciality\":21,\"id_faculty\":0,\"id_edu_year\":25,\"id_period\":1,\"course_id\":259421,\"subject_type\":null,\"id_subject_type\":1,\"user_id\":2891,\"active\":true,\"created_at\":\"2025-11-10T07:44:18.000000Z\",\"updated_at\":\"2026-02-25T06:12:59.000000Z\",\"proverka\":true,\"id_semester\":10,\"id_language\":1},\"chills\":null,\"count_attempt\":null,\"my_score\":null,\"details\":[],\"answer_id\":null,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}}}"
