          "content": {
            "size": 6298,
            "mimeType": "application/json",
            "text": "[{\"id\":259421,\"user_id\":2891,\"title\":\"Advanced methods of clinical research \",\"slug\":null,\"description\":\"The course Advanced Methods of Clinical Research is designed to provide graduate students with an in-depth understanding of the methodological, ethical, and analytical foundations of modern clinical research. It focuses on the design, implementation, and interpretation of advanced clinical studies, including randomized controlled trials (RCTs), cohort and case-control studies, systematic reviews, and meta-analyses.\\r\\n\\r\\nStudents will learn to critically evaluate scientific evidence, apply biostatistical approaches to data analysis, and develop research protocols consistent with Good Clinical Practice (GCP) and international ethical standards (ICH-GCP, Helsinki Declaration).\\r\\nSpecial attention is given to translational research, clinical data management, evidence-based medicine principles, and the use of digital technologies in modern clinical investigations.\",\"image\":\"https:\\/\\/api.mooc.oshsu.kg\\/public\\/images\\/courses\\/1771998920.png\",\"video_url\":\"\",\"status\":true,\"created_at\":\"2025-11-10T07:43:16.000000Z\",\"updated_at\":\"2026-02-25T06:12:34.000000Z\",\"is_published\":true,\"course_audience_type_id\":1,\"course_category_id\":null,\"language_id\":null,\"is_featured\":false,\"archived\":false,\"image_url\":\"https:\\/\\/api.mooc.oshsu.kg\\/public\\/images\\/courses\\/https:\\/\\/api.mooc.oshsu.kg\\/public\\/images\\/courses\\/1771998920.png\",\"user\":{\"id\":2891,\"myedu_id\":46372,\"name\":\"\\u041b\\u0430\\u0437\\u043e\\u043a\\u0430\\u0442\\u0445\\u0430\\u043d\",\"last_name\":\"\\u0414\\u0436\\u0443\\u043c\\u0430\\u0435\\u0432\\u0430\",\"father_name\":\"\\u041c\\u0430\\u0434\\u0430\\u043c\\u0438\\u043d\\u043e\\u0432\\u043d\\u0430\",\"email\":\"ldjumaeva@oshsu.kg\",\"phone\":\"555000000\",\"email_verified_at\":null,\"is_working\":true,\"is_student\":false,\"pin\":1,\"birth_date\":null,\"created_at\":\"2025-11-10T07:32:13.000000Z\",\"updated_at\":\"2026-03-15T02:58:49.000000Z\",\"telegram_chat_id\":\"720281311\",\"telegram_bind_token\":\"zAfxR3EM3YeQRCzPLpLFfHK6wQN4tpxZ\"},\"lessons\":[{\"id\":18825,\"user_id\":2891,\"course_id\":259421,\"title\":\"Lecture #1. Introduction\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-02-09T05:07:03.000000Z\",\"updated_at\":\"2026-02-24T09:46:15.000000Z\",\"sequence_number\":1,\"from\":\"2026-02-24\",\"to\":\"2026-02-28\",\"active\":false},{\"id\":18945,\"user_id\":2891,\"course_id\":259421,\"title\":\"Lecture #2. Types of Clinical Research\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-02-09T10:54:48.000000Z\",\"updated_at\":\"2026-02-24T09:46:41.000000Z\",\"sequence_number\":2,\"from\":\"2026-03-02\",\"to\":\"2026-03-05\",\"active\":false},{\"id\":19283,\"user_id\":2891,\"course_id\":259421,\"title\":\"Practical class #1. Clinical Research Architecture\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-02-11T12:12:53.000000Z\",\"updated_at\":\"2026-02-24T09:47:05.000000Z\",\"sequence_number\":3,\"from\":\"2026-03-02\",\"to\":\"2026-03-05\",\"active\":false},{\"id\":20353,\"user_id\":2891,\"course_id\":259421,\"title\":\"Lecture #3. From Clinical Idea to Research Protocol\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-02-19T05:12:45.000000Z\",\"updated_at\":\"2026-02-24T09:47:35.000000Z\",\"sequence_number\":4,\"from\":\"2026-03-05\",\"to\":\"2026-03-08\",\"active\":false},{\"id\":20354,\"user_id\":2891,\"course_id\":259421,\"title\":\"Lecture #4. ETHICS IN CLINICAL RESEARCH\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-02-19T05:14:33.000000Z\",\"updated_at\":\"2026-02-24T09:48:54.000000Z\",\"sequence_number\":5,\"from\":\"2026-03-09\",\"to\":\"2026-03-12\",\"active\":false},{\"id\":20941,\"user_id\":2891,\"course_id\":259421,\"title\":\"Practical class#2. From Clinical Question to Hypothesis: PICO\\/PEO Methodology.\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-02-24T09:01:09.000000Z\",\"updated_at\":\"2026-02-24T09:48:33.000000Z\",\"sequence_number\":6,\"from\":\"2026-03-05\",\"to\":\"2026-03-08\",\"active\":false},{\"id\":20942,\"user_id\":2891,\"course_id\":259421,\"title\":\"Practical class#3. Research Design , Sampling Design Process\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-02-24T09:30:33.000000Z\",\"updated_at\":\"2026-02-24T09:50:01.000000Z\",\"sequence_number\":7,\"from\":\"2026-03-09\",\"to\":\"2026-03-12\",\"active\":false},{\"id\":22046,\"user_id\":2891,\"course_id\":259421,\"title\":\"Practical class #4. Bioethics and Patient Rights: Development of Documentation.\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-03-05T17:21:29.000000Z\",\"updated_at\":\"2026-03-05T17:21:29.000000Z\",\"sequence_number\":8,\"from\":null,\"to\":null,\"active\":true},{\"id\":22047,\"user_id\":2891,\"course_id\":259421,\"title\":\"Lecture #5. Statistics in medical research.\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-03-05T18:32:01.000000Z\",\"updated_at\":\"2026-03-05T18:32:01.000000Z\",\"sequence_number\":9,\"from\":\"2026-03-13\",\"to\":\"2026-03-15\",\"active\":false},{\"id\":22349,\"user_id\":2891,\"course_id\":259421,\"title\":\"Lecture #6. Methods of Data Collection Digital Integration\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-03-10T06:39:37.000000Z\",\"updated_at\":\"2026-03-10T06:39:37.000000Z\",\"sequence_number\":10,\"from\":\"2026-03-16\",\"to\":\"2026-03-18\",\"active\":true},{\"id\":22390,\"user_id\":2891,\"course_id\":259421,\"title\":\"Practical class #5. Information Sources and Critical Appraisal of Clinical Studies\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-03-10T10:01:49.000000Z\",\"updated_at\":\"2026-03-10T10:01:49.000000Z\",\"sequence_number\":11,\"from\":\"2026-03-16\",\"to\":\"2026-03-18\",\"active\":true},{\"id\":20925,\"user_id\":2891,\"course_id\":259421,\"title\":\"Module\",\"is_deleted\":false,\"is_published\":true,\"published_at\":null,\"created_at\":\"2026-02-23T18:59:47.000000Z\",\"updated_at\":\"2026-02-24T09:14:40.000000Z\",\"sequence_number\":14,\"from\":\"2026-03-23\",\"to\":\"2026-03-26\",\"active\":false}],\"connections\":[{\"id\":2086,\"id_stream\":228909,\"id_curricula\":37853,\"id_subject\":10339,\"id_speciality\":21,\"id_faculty\":0,\"id_edu_year\":25,\"id_period\":1,\"course_id\":259421,\"subject_type\":null,\"id_subject_type\":1,\"user_id\":2891,\"active\":true,\"created_at\":\"2025-11-10T07:44:18.000000Z\",\"updated_at\":\"2026-02-25T06:12:59.000000Z\",\"proverka\":true,\"id_semester\":10,\"id_language\":1}]}]"
