          "content": {
            "size": 2010,
            "mimeType": "application/json",
            "text": "{\"success\":true,\"step\":{\"id\":82974,\"id_parent\":38198,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22349,\"step\":5,\"active\":false,\"created_at\":\"2026-03-10T06:48:47.000000Z\",\"updated_at\":\"2026-03-10T06:49:44.000000Z\",\"score\":0,\"content\":{\"id\":38198,\"lesson_id\":22349,\"content\":\"Which of the following best describes the difference between routine clinical documentation and research-grade data?\\n \",\"score\":0,\"image\":null,\"answers\":[{\"id\":145050,\"text\":\"Clinical documentation focuses on narrative descriptions, whereas research data must allow standardized comparison and analysis across participants.\"},{\"id\":145051,\"text\":\"Research data are typically less detailed than clinical documentation because they focus only on primary outcomes.\"},{\"id\":145052,\"text\":\"Clinical documentation is mainly designed for statistical analysis, while research data focus on patient care.\"},{\"id\":145053,\"text\":\"Research data usually exclude subjective patient-reported information.\"}],\"created_at\":\"2026-03-10T06:49:44.000000Z\",\"updated_at\":\"2026-03-10T06:49:44.000000Z\"},\"connections\":{\"id\":2086,\"id_stream\":228909,\"id_curricula\":37853,\"id_subject\":10339,\"id_speciality\":21,\"id_faculty\":0,\"id_edu_year\":25,\"id_period\":1,\"course_id\":259421,\"subject_type\":null,\"id_subject_type\":1,\"user_id\":2891,\"active\":true,\"created_at\":\"2025-11-10T07:44:18.000000Z\",\"updated_at\":\"2026-02-25T06:12:59.000000Z\",\"proverka\":true,\"id_semester\":10,\"id_language\":1},\"chills\":true,\"count_attempt\":1,\"my_score\":0,\"details\":[{\"id\":98760,\"lesson_step_answer_id\":1416631,\"user_id\":15545,\"answer_id\":145050,\"is_correct\":true,\"file\":\"https:\\/\\/api.mooc.oshsu.kg\\/public\\/storage\",\"answered_at\":null,\"id_teacher\":null,\"comment\":null,\"created_at\":\"2026-03-16T01:14:52.000000Z\",\"updated_at\":\"2026-03-16T01:14:52.000000Z\"}],\"answer_id\":145050,\"type\":{\"id\":4,\"title\":