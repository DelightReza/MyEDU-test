            "size": 4006,
            "mimeType": "application/json",
            "text": "[{\"id\":81806,\"id_parent\":15672,\"type_id\":2,\"user_id\":2891,\"lesson_id\":22046,\"step\":1,\"active\":false,\"created_at\":\"2026-03-05T17:21:47.000000Z\",\"updated_at\":\"2026-03-05T17:22:02.000000Z\",\"score\":0,\"content\":{\"id\":15672,\"lesson_id\":22046,\"title\":\"Bioethics and Patient Rights: Development of Documentation.\",\"description\":\"\",\"document\":\"2891_22046_1772731322.pdf\",\"document_path\":\"https:\\/\\/api.mooc.oshsu.kg\\/public\\/teacher\\/files\\/lesson\\/documents\\/2891_22046_1772731322.pdf\",\"created_at\":\"2026-03-05T17:22:02.000000Z\"},\"chills\":true,\"count_attempt\":null,\"my_score\":0,\"type\":{\"id\":2,\"title\":\"\\u0414\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\",\"modelName\":\"Document\",\"logo\":\"pi pi-folder\",\"name\":\"document\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":1}},{\"id\":81807,\"id_parent\":37573,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22046,\"step\":2,\"active\":false,\"created_at\":\"2026-03-05T17:22:17.000000Z\",\"updated_at\":\"2026-03-05T17:23:46.000000Z\",\"score\":1,\"content\":{\"id\":37573,\"lesson_id\":22046,\"content\":\"A retrospective case series analyzes medical records of 6 patients without changing their treatment. What must be clearly stated in the \\u201cDescription of the Method\\u201d section?\",\"score\":1,\"image\":null,\"answers\":[{\"id\":142547,\"text\":\"The publication journal target\"},{\"id\":142548,\"text\":\"The statistical methods used in the analysis\"},{\"id\":142549,\"text\":\"That no additional interventions will be performed\"},{\"id\":142550,\"text\":\"The expected therapeutic benefit for the participant\"}],\"created_at\":\"2026-03-05T17:23:46.000000Z\",\"updated_at\":\"2026-03-05T17:23:46.000000Z\"},\"chills\":true,\"count_attempt\":1,\"my_score\":1,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}},{\"id\":81809,\"id_parent\":37574,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22046,\"step\":3,\"active\":false,\"created_at\":\"2026-03-05T17:23:56.000000Z\",\"updated_at\":\"2026-03-05T17:25:19.000000Z\",\"score\":1,\"content\":{\"id\":37574,\"lesson_id\":22046,\"content\":\"In a retrospective study with no new interventions, which risk must still be described in the \\u201cPotential Risks\\u201d section?\\n\",\"score\":1,\"image\":null,\"answers\":[{\"id\":142551,\"text\":\"Risk of data breach or indirect identification\"},{\"id\":142552,\"text\":\"Risk of surgical complications\"},{\"id\":142553,\"text\":\"Risk of placebo exposure\"},{\"id\":142554,\"text\":\"Risk of drug toxicity\"}],\"created_at\":\"2026-03-05T17:25:19.000000Z\",\"updated_at\":\"2026-03-05T17:25:19.000000Z\"},\"chills\":true,\"count_attempt\":1,\"my_score\":1,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}},{\"id\":81811,\"id_parent\":37576,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22046,\"step\":4,\"active\":false,\"created_at\":\"2026-03-05T17:25:53.000000Z\",\"updated_at\":\"2026-03-05T17:27:19.000000Z\",\"score\":1,\"content\":{\"id\":37576,\"lesson_id\":22046,\"content\":\"Which sentence is most appropriate in the \\u201cPotential Benefit\\u201d section of a small observational study?\\n\\n\\n\\n\",\"score\":1,\"image\":null,\"answers\":[{\"id\":142559,\"text\":\"\\u201cThis study will improve your clinical outcome.\\u201d\"},{\"id\":142560,\"text\":\"\\u201cParticipation guarantees closer medical supervision.\\u201d\"},{\"id\":142561,\"text\":\"\\u201cThe treatment will likely improve your condition.\\u201d\"},{\"id\":142562,\"text\":\"\\u201cYou may not receive any direct medical benefit from participation.\\u201d\"}],\"created_at\":\"2026-03-05T17:27:19.000000Z\",\"updated_at\":\"2026-03-05T17:27:19.000000Z\"},\"chills\":true,\"count_attempt\":1,\"my_score\":1,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}}]"
