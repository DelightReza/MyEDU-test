            "size": 1724,
            "mimeType": "application/json",
            "text": "{\"success\":true,\"step\":{\"id\":82979,\"id_parent\":38201,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22349,\"step\":6,\"active\":false,\"created_at\":\"2026-03-10T06:50:12.000000Z\",\"updated_at\":\"2026-03-10T06:51:11.000000Z\",\"score\":1,\"content\":{\"id\":38201,\"lesson_id\":22349,\"content\":\"Which of the following best describes the difference between routine clinical documentation and research-grade data?\\n\",\"score\":1,\"image\":null,\"answers\":[{\"id\":145062,\"text\":\"Clinical documentation focuses on narrative descriptions, whereas research data must allow standardized comparison and analysis across participants.\"},{\"id\":145063,\"text\":\"Research data are typically less detailed than clinical documentation because they focus only on primary outcomes.\"},{\"id\":145064,\"text\":\"Clinical documentation is mainly designed for statistical analysis, while research data focus on patient care.\"},{\"id\":145065,\"text\":\"Research data usually exclude subjective patient-reported information.\"}],\"created_at\":\"2026-03-10T06:51:11.000000Z\",\"updated_at\":\"2026-03-10T06:51:11.000000Z\"},\"connections\":{\"id\":2086,\"id_stream\":228909,\"id_curricula\":37853,\"id_subject\":10339,\"id_speciality\":21,\"id_faculty\":0,\"id_edu_year\":25,\"id_period\":1,\"course_id\":259421,\"subject_type\":null,\"id_subject_type\":1,\"user_id\":2891,\"active\":true,\"created_at\":\"2025-11-10T07:44:18.000000Z\",\"updated_at\":\"2026-02-25T06:12:59.000000Z\",\"proverka\":true,\"id_semester\":10,\"id_language\":1},\"chills\":null,\"count_attempt\":null,\"my_score\":null,\"details\":[],\"answer_id\":null,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"logo\":\"pi pi-list-check\",\"name\":\"test\",\"active\":true,\"created_at\":\"2025-09-02T09:31:58.000000Z\",\"updated_at\":\"2025-09-02T09:32:01.000000Z\",\"order\":4}}}"
