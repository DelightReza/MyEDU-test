            "mimeType": "application/json",
            "text": "{\"success\":true,\"step\":{\"id\":82972,\"id_parent\":38196,\"type_id\":4,\"user_id\":2891,\"lesson_id\":22349,\"step\":4,\"active\":false,\"created_at\":\"2026-03-10T06:46:57.000000Z\",\"updated_at\":\"2026-03-10T06:48:39.000000Z\",\"score\":1,\"content\":{\"id\":38196,\"lesson_id\":22349,\"content\":\"Which statement best explains why data collection quality is considered a critical component of clinical research?\\n \",\"score\":1,\"image\":null,\"answers\":[{\"id\":145042,\"text\":\"Statistical methods are unable to compensate for systematic errors introduced during data collection.\"},{\"id\":145043,\"text\":\"Regulatory agencies only approve studies conducted with digital data collection systems.\"},{\"id\":145044,\"text\":\"Clinical research conclusions depend primarily on the number of participants rather than data quality.\"},{\"id\":145045,\"text\":\"Data errors mainly affect administrative aspects of a study rather than scientific conclusions.\"}],\"created_at\":\"2026-03-10T06:48:39.000000Z\",\"updated_at\":\"2026-03-10T06:48:39.000000Z\"},\"connections\":{\"id\":2086,\"id_stream\":228909,\"id_curricula\":37853,\"id_subject\":10339,\"id_speciality\":21,\"id_faculty\":0,\"id_edu_year\":25,\"id_period\":1,\"course_id\":259421,\"subject_type\":null,\"id_subject_type\":1,\"user_id\":2891,\"active\":true,\"created_at\":\"2025-11-10T07:44:18.000000Z\",\"updated_at\":\"2026-02-25T06:12:59.000000Z\",\"proverka\":true,\"id_semester\":10,\"id_language\":1},\"chills\":true,\"count_attempt\":1,\"my_score\":1,\"details\":[{\"id\":98759,\"lesson_step_answer_id\":1416630,\"user_id\":15545,\"answer_id\":145042,\"is_correct\":true,\"file\":\"https:\\/\\/api.mooc.oshsu.kg\\/public\\/storage\",\"answered_at\":null,\"id_teacher\":null,\"comment\":null,\"created_at\":\"2026-03-16T01:14:44.000000Z\",\"updated_at\":\"2026-03-16T01:14:44.000000Z\"}],\"answer_id\":145042,\"type\":{\"id\":4,\"title\":\"\\u0422\\u0435\\u0441\\u0442\",\"modelName\":\"Test\",\"